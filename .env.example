# ============================================================
# Liz Chat Backend — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env real.
# ============================================================

# Porta da API (o frontend aponta para http://localhost:3000/api)
PORT=3000

# Origens permitidas no CORS (separadas por vírgula).
# Vazio = libera apenas localhost em qualquer porta (dev).
CORS_ORIGIN=

# ---------- Banco de dados ----------
# Produção (Postgres):
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liz_chat
DB_USER=postgres
DB_PASS=
DB_SSL=false

# Dev local sem Postgres — descomente as duas linhas abaixo
# e comente DB_DIALECT=postgres:
# DB_DIALECT=sqlite
# DB_STORAGE=data/liz.sqlite

# ---------- Provedor de IA (OpenAI-compatível) ----------
# Sem AI_API_URL, o backend responde em modo demo (demo: true no payload).
AI_API_URL=
AI_API_KEY=
AI_MODEL=
