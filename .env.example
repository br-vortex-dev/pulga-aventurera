# ============================================================
# Liz Chat Backend — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env real.
# ============================================================

# Porta da API (o frontend aponta para http://localhost:3000/api)
PORT=3000

# Origens permitidas no CORS (separadas por vírgula).
# Vazio = libera apenas localhost em qualquer porta (dev).
CORS_ORIGIN=

# ---------- Banco de dados ----------
# Nuvem (Render/Supabase): basta DATABASE_URL — ela manda em tudo.
# DATABASE_URL=postgres://usuario:senha@host:5432/dbname

# Produção (Postgres por partes):
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liz_chat
DB_USER=postgres
DB_PASS=
DB_SSL=false

# Dev local sem Postgres — descomente as duas linhas abaixo
# e comente DB_DIALECT=postgres:
# DB_DIALECT=sqlite
# DB_STORAGE=data/liz.sqlite

# ---------- Provedor de IA (OpenAI-compatível) ----------
# Sem AI_API_URL, o backend responde em modo demo (demo: true no payload).
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ---------- Firebase Authentication (tela de login) ----------
# 1. Acesse https://console.firebase.google.com e crie/abra um projeto
# 2. Configurações do projeto → Seus apps → adicione um app Web (</>)
# 3. Copie os valores do objeto firebaseConfig para as variáveis abaixo
# 4. Em Authentication → Sign-in method, ative E-mail/senha, Google e GitHub
# Sem essas variáveis, o GET /api/firebase-config retorna 503.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cliente OAuth Web (Google Auth Platform > Clientes) — usado no
# fluxo de login Google sem popup (necessário p/ Brave/cookies bloqueados)
GOOGLE_OAUTH_CLIENT_ID=

# ---------- Validação de sessão no backend (Firebase Admin) ----------
# Service Account em JSON (UMA LINHA) para o backend validar os tokens
# de quem usa a API. Como gerar:
#   Firebase Console → Configurações do projeto → Contas de serviço →
#   "Gerar nova chave privada" → cole o conteúdo do .json aqui, sem quebras.
# Sem ela, fora de produção a API degrada para um usuário "dev-local";
# em produção (NODE_ENV=production) as rotas de dados recusam tudo.
FIREBASE_SERVICE_ACCOUNT=
